# Environment variable template — copy to configs/.env and fill in values.
# Never commit the real configs/.env file to version control.
#
# Infrastructure note:
#   PostgreSQL is installed locally (not in Docker).
#   Install: https://www.postgresql.org/download/windows/
#   Manage:  pgAdmin (local)
#   Database must be created manually before starting the API.

# --- PostgreSQL (local installation) ---
POSTGRES_DB=market_intelligence
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Assembled DATABASE_URL used by SQLAlchemy
DATABASE_URL=postgresql://postgres:your_secure_password_here@localhost:5432/market_intelligence

# --- App ---
APP_ENV=development
DEBUG=true

# --- Gemini AI ---
GEMINI_API_KEY=your_gemini_api_key_here
